# ============================================================
# BetweenYears — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# ── Virtual environments ──────────────────────────────────────
backend/venv/
backend/.venv/
venv/
.venv/
env/
.env/

# ── Secrets & environment variables ──────────────────────────
# NEVER commit real secrets
backend/.env
.env
.env.local
.env.*.local
*.env

# ── Compiled / dist artifacts ─────────────────────────────────
*.egg-info/
dist/
build/
*.egg
*.whl

# ── pytest / coverage ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coverage

# ── MyPy / type checkers ──────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ── Jupyter notebooks (if used for analysis) ─────────────────
.ipynb_checkpoints/

# ── OS & system files ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDEs & editors ────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
# Keep .vscode/extensions.json if you want shared extension recommendations
!.vscode/extensions.json

.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Node (if you ever add a frontend build step) ─────────────
node_modules/
.npm/
.pnpm-store/
package-lock.json
yarn.lock
.pnp.*

# ── Temporary files ───────────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.orig

# ── Security ──────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
secrets/
